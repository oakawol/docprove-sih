# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Base URL for the FastAPI backend. Leave empty for local dev (Vite proxy handles it).
# Set to the deployed backend URL for production, e.g. https://api.docprove.example.com
VITE_API_BASE_URL=

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
# Path to the Tesseract OCR executable. If not set, uses the system PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: usually not needed (tesseract is on PATH after apt install)
TESSERACT_CMD=

# Comma-separated list of allowed CORS origins.
# Default: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
